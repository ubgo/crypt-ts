# Normalize line endings to LF on checkin; let Git decide on checkout.
* text=auto eol=lf

# Explicitly treat sources and common text as text.
*.ts      text
*.tsx     text
*.js      text
*.cjs     text
*.mjs     text
*.json    text
*.md      text
*.yml     text
*.yaml    text
*.sh      text eol=lf

# Known-answer vectors are exact bytes — never munge.
testdata/vectors.json text eol=lf

# Binary assets (if any land here) — never diff/merge as text.
*.png     binary
*.jpg     binary
*.gif     binary
*.ico     binary

# Keep tests/examples/docs and generated output out of GitHub language stats.
__tests__/**  linguist-language=TypeScript
examples/**   linguist-documentation
dist/**       linguist-generated
coverage/**   linguist-generated
*.md          linguist-documentation
pnpm-lock.yaml linguist-generated
